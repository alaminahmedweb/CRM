@using ApplicationCore.DtoModels;
@model DashboardDto
@{
    ViewData["Title"] = "Home Page";
    var totalCount = 0;
}
<style>
    .hover-link {
        color: inherit;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .hover-link:hover {
            color: #007bff;
            text-decoration: underline;
        }
</style>

<h1 class="page-title">Dashboard</h1>

<div class="row">
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2 ">
            <div class="display">
                <div class="number">
                    <h3 class="font-yellow-gold">
                        <span data-counter="counterup" data-value="@Model.TodayTotalFollowupQty">@Model.TodayTotalFollowupQty</span>
                    </h3>
                    <small>TODAY FOLLOWUP</small>
                </div>
                <div class="icon">
                    <i class="far fa-envelope-open"></i>
                </div>
            </div>

        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2 ">
            <div class="display">
                <div class="number">
                    <h3 class="font-yellow-gold">
                        <span data-counter="counterup" data-value="@Model.TodayFollowupDoneQty">@Model.TodayFollowupDoneQty</span>
                    </h3>
                    <small>FOLLOWUP DONE</small>
                </div>
                <div class="icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>

        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2 ">
            <div class="display">
                <div class="number">
                    <h3 class="font-green-jungle">
                        <span data-counter="counterup" data-value="@Model.TodayRemainingFollowupQty">@Model.TodayRemainingFollowupQty</span>
                    </h3>
                    <small>FOLLOWUP PENDING</small>
                </div>
                <div class="icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2 ">
            <div class="display">
                <div class="number">
                    <h3 class="font-green-jungle">
                        <span data-counter="counterup" data-value="3,507">@Model.TodayNewCustomer</span>
                    </h3>
                    <small>TODAY NEW CUSTOMER </small>
               </div>
                <div class="icon">
                    <i class="far fa-envelope-open"></i>
                </div>
            </div>

        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2" >
            <div class="display">
                <div class="number">
                    <h3 class="font-yellow-gold">
                        <span data-counter="counterup" data-value="@Model.BookingCancelRequestQty">@Model.BookingCancelRequestQty</span>
                    </h3>
                    <small style="color:blue" class="hover-link" id="bookingCancelStat">CANCEL REQUEST</small>
                </div>
                <div class="icon">
                    <i class="far fa-envelope-open"></i>
                </div>
            </div>

        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2" >
            <div class="display">
                <div class="number">
                    <h3 class="font-yellow-gold">
                        <span data-counter="counterup" data-value="@Model.BookingShiftRequestQty">@Model.BookingShiftRequestQty</span>
                    </h3>
                    <small style="color:blue" class="hover-link" id="bookingShiftStat">SHIFT REQUEST</small>
                </div>
                <div class="icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>

        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2" >
            <div class="display">
                <div class="number">
                    <h3 class="font-green-jungle">
                        <span data-counter="counterup" data-value="@Model.AmountChangeRequestQty">@Model.AmountChangeRequestQty</span>
                    </h3>
                    <small style="color:blue" class="hover-link" id="amountChageStat">AMT CHANGE REQUEST</small>
                </div>
                <div class="icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
        <div class="dashboard-stat2" >
            <div class="display">
                <div class="number">
                    <h3 class="font-green-jungle">
                        <span data-counter="counterup" data-value="3,507">@Model.VoucherApproveRequestQty</span>
                    </h3>
                    <small style="color:blue" class="hover-link" id="voucherApproveStat">VOU. APPROVE REQ </small>
                </div>
                <div class="icon">
                    <i class="far fa-envelope-open"></i>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-9 col-sm-6">
        <div class="portlet light ">
            <div class="portlet-title">
                <div class="caption">
                    @*<span class="caption-subject bold uppercase font-dark">Progress</span>*@
                    @*<span class="caption-helper">Last 6 Months</span>*@
                </div>
            </div>
            <div class="portlet-body">
                @*<div id="chart" class="chart" style="height: 333px;"> </div>*@
                <canvas id="myChart" style="width:100%;max-width:600px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="dashboard-stat2" >
            <div class="display">
                <div class="number">
                    <h3 class="font-green-jungle">
                        <span data-counter="counterup" data-value="3,507">@Model.AdvanceApproveRequestQty</span>
                    </h3>
                    <small style="color:blue" class="hover-link" id="advanceApproveStat">ADV. APPROVE REQ </small>
                </div>
                <div class="icon">
                    <i class="far fa-envelope-open"></i>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <p class="panel-title uppercase bold">BOOKING ENTRY(TODAY)</p>
            </div>
            <ul class="list-group">
                <li class="list-group-item">
                    Total QTY: @Model.TodayBookingQty
                </li>
                <li class="list-group-item">
                    Total AMT: BDT @Model.TodayBookingAmount
                </li>
            </ul>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <p class="panel-title uppercase bold">BOOKING (THIS MONTH)</p>
            </div>
            <ul class="list-group">
                <li class="list-group-item">
                    Total QTY: @Model.ThisMonthBookingQty
                </li>
                <li class="list-group-item">
                    Total AMT: BDT @Model.ThisMonthBookingAmount
                </li>
            </ul>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <p class="panel-title uppercase bold">TOTAL CUSTOMER</p>
            </div>
            <ul class="list-group">
                <li class="list-group-item">QTY : @Model.TotalCustomer</li>
            </ul>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <p class="panel-title uppercase bold">COMPLAIN PENDING (THIS MONTH)</p>
            </div>
            <ul class="list-group">
                <li class="list-group-item">QTY : @Model.ThisMonthComplainPendingQty</li>
            </ul>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <p class="panel-title uppercase bold">DIGITAL RESPONSE (TODAY)</p>
            </div>
            <ul class="list-group">
                @foreach (var item in Model.TodayContactWiseCustomerList)
                {
                    <li class="list-group-item"> @item.GroupName : @item.TotalCount </li>
                    {
                        totalCount = totalCount + item.TotalCount;
                    }
                }
                <li class="list-group-item bold"> Total : @totalCount </li>
            </ul>
        </div>
    </div>
</div>

@section scripts
    {

    <script>
        $(document).ready(function() {
            $('#advanceApproveStat').click(function() {
                window.location.href = '@Url.Action("GetAllPendingAdvanceList", "AdvanceLedger")';
            });
            $('#bookingCancelStat').click(function() {
                window.location.href = '@Url.Action("ShowAllPendingBookingCancelData", "Booking")';
            });
            $('#bookingShiftStat').click(function() {
                window.location.href = '@Url.Action("ShowAllPendingBookingShiftData", "Booking")';
            });
            $('#amountChageStat').click(function() {
                window.location.href = '@Url.Action("ShowAllPendingBookingAmtUpdateData", "Booking")';
            });
            $('#voucherApproveStat').click(function() {
                window.location.href = '@Url.Action("Index", "VoucherApprove")';
            });

        });

        var xValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PieLabels)); //["January", "February", "March", "April", "May","June","July","August","September","October","November","December"];
        var yValues = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.PieData));//[55, 49, 44, 24, 15, 55, 49, 44, 24, 15, 20, 30];
        var barColors = ["red", "green", "blue", "orange", "brown","red", "green", "blue", "orange", "brown","red","green"];

        new Chart("myChart", {
            type: "bar",
            data: {
                labels: xValues,
                datasets: [{
                    backgroundColor: barColors,
                    data: yValues
                }]
            },
            options: {
                legend: { display: false },
                title: {
                    display: true,
                    text: "Monthly Booking Count"
                }
            }
        });
    </script>
    }
