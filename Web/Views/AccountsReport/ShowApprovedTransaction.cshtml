@model List<Transact>
@{
    Layout = "_Report";
    var totaldebit = 0.0;
    var totalCredit = 0.0;
    var subTotalDebit = 0.0;
    var subTotalCredit = 0.0;
    int currentTrno = 0;
    int prevTrNo = 0;
    bool isFirstRow = true;
}

<div style="overflow-x: auto;">
    <div class="table">
        <table>
            <thead>
                <tr>
                    <th>Tr No</th>
                    <th>Tr Date</th>
                    <th>V.Type</th>
                    <th>V.No</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Narration</th>
                    <th>Debit</th>
                    <th>Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var data in Model.OrderBy(x => x.TrNo).ThenBy(x => x.Id))
                {
                    currentTrno = data.TrNo;

                    // Reset subtotal when starting a new group
                    if (currentTrno != prevTrNo && !isFirstRow)
                    {
                        // Add subtotal row for previous group
                        <tr style="font-weight: bold; background-color: #f5f5f5;">
                            <td colspan="6"></td>
                            <td>Sub Total</td>
                            <td style="text-align:right !important;">@subTotalDebit.ToString("N2")</td>
                            <td style="text-align:right !important;">@subTotalCredit.ToString("N2")</td>
                        </tr>

                        // Reset subtotal counters
                        subTotalDebit = 0;
                        subTotalCredit = 0;
                    }

                    // Accumulate totals
                    subTotalDebit += data.Debit;
                    subTotalCredit += data.Credit;
                    totaldebit += data.Debit;
                    totalCredit += data.Credit;

                    <tr>
                        <td>@data.TrNo</td>
                        <td>@data.ApprovedDate.ToString("dd/MM/yyyy")</td>
                        <td>@data.VoucherType</td>
                        <td>@data.VoucherNo</td>
                        <td>@data.Code</td>
                        <td>@data.Description</td>
                        <td>@data.Narration</td>
                        <td style="text-align: right !important;">@data.Debit.ToString("N2")</td>
                        <td style="text-align: right !important;">@data.Credit.ToString("N2")</td>
                    </tr>

                    prevTrNo = currentTrno;
                    isFirstRow = false;
                }

                @* Add final subtotal for the last group *@
                @if (Model.Any())
                {
                    <tr style="font-weight: bold; background-color: #f5f5f5;">
                        <td colspan="6"></td>
                        <td>Sub Total</td>
                        <td style="text-align:right !important;">@subTotalDebit.ToString("N2")</td>
                        <td style="text-align:right !important;">@subTotalCredit.ToString("N2")</td>
                    </tr>
                }

                @* Grand Total *@
                <tr style="font-weight: bold;text-align:center; background-color: #e0e0e0; border-top: 2px solid #000;">
                    <td colspan="6"></td>
                    <td>GRAND TOTAL</td>
                    <td>@totaldebit.ToString("N2")</td>
                    <td>@totalCredit.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
        text-align: center;
    }

    th {
        background-color: #007bff;
        color: white;
        padding: 10px;
        text-align: center;
        border: 1px solid #ddd;
    }

    td {
        padding: 8px;
        border: 1px solid #ddd;
        vertical-align: top;
        text-align: center;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    tr:hover {
        background-color: #f0f0f0;
    }
</style>