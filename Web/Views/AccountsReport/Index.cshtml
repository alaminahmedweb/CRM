@model DateRangeVM
@{
    ViewData["Title"] = "Accounts Report";
}
<div class="row mb-4">
    <div class="col-lg-3 col-md-3 col-sm-3 col-2"></div>
    <div class="col-lg-6 col-md-12 col-sm-12 col-12 bg-white">
        <div class="form-group">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12" style="display: flex;justify-content: space-between;margin-left: 18px;">
                <div class="col-lg-12 col-md-6 col-sm-6 col-12">
                    <h3 class=" pl-1 text-info text-center" style="font-weight:600"> Accounts Report</h3>
                </div>
            </div>
        </div>
        <hr style="margin: 0.1rem 0;" />
        <form>
            <div class="form-group row pt-1 pb-3" style="margin-left: 38px;margin-right:20px;opacity:1 !important;">
                <div class="col-lg-6 col-md-6 col-sm-12 col-6">
                    <div>
                        <label for="DateFrom" class="form-label">Date From</label>
                        <input asp-for="DateFrom" class="form-control" />
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12 col-6">
                    <div>
                        <label for="DateTo" class="form-label">Date To</label>
                        <input asp-for="DateTo" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group row pb-6" style="margin-left: 38px;margin-right:20px;opacity:1 !important;">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div>
                        <label for="AcCode" class="form-label">Ac/Code</label>
                        <select asp-for="AcCode" class="form-control js-example-basic-single" title="searchableDropdown">
                            <option value="-1">Please Select Code</option>
                            @foreach (var data in ViewBag.CodeList)
                            {
                                <option value="@data.Code">@string.Concat(@data.Code, "-", @data.Description)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="accordion" id="accordionExample">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            Accounts Related Report
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                        <div class="accordion-body">
                            <div class="d-grid gap-1">
                                <button type="submit" id="btnReceiveAndPayment" class="btn btn-primary btn-block">Receive And Payment</button>
                                <button type="submit" id="btnDailySalesAndCollection" class="btn btn-primary btn-block">Daily Sales And Collection Report</button>
                                <button type="submit" id="btnTransactList" class="btn btn-primary btn-block">Transaction List</button>
                                <button type="submit" id="btnDailyReceiveAndPayment" class="btn btn-primary btn-block">Daily Receive And Payment</button>
                                <button type="submit" id="btnProfitAndLossAc" class="btn btn-primary btn-block">Profit And Loss A/C</button>
                                <button type="submit" id="btnLedgerQuery" class="btn btn-primary btn-block">Ledger Query</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        $(document).ready(function () {

            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!

            var currentDate = today.getFullYear() + "-" + mm + "-" + dd;
            $('#DateFrom').val(currentDate);
            $('#DateTo').val(currentDate);
            var datefrom = currentDate;
            var dateto = currentDate;
            $('.js-example-basic-single').select2();
        });

        $('#btnReceiveAndPayment').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowReceiveAndPayment?dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });

        $('#btnDailySalesAndCollection').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowDailySalesAndCollection?dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });

        $('#btnTransactList').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowApprovedTransaction?dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });

        $('#btnDailyReceiveAndPayment').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowDailyReceiveAndPayment?dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });

        $('#btnProfitAndLossAc').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowProfitAndLossAcc?dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });

        $('#btnLedgerQuery').click(function () {
            var dateFrom = $('#DateFrom').val();
            var dateTo = $('#DateTo').val();
            var acCode = $('#AcCode').val();
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetSuccessData", "AccountsReport")",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (result) {
                    window.location.href = "/AccountsReport/ShowLedgerQuery?acCode="+ acCode +"&dateFrom=" + dateFrom + "&dateTo=" + dateTo + "";
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });
        });
    </script>

}