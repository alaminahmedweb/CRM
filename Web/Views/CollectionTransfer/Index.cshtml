@model DateRangeVM
@{
    ViewData["Title"] = "Collection Transfer";
}
<div class="row mb-4">
    <div class="col-lg-3 col-md-3 col-sm-3 col-2"></div>
    <div class="col-lg-6 col-md-12 col-sm-12 col-12 bg-white">
        <div class="form-group">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12" style="display: flex;justify-content: space-between;margin-left: 18px;">
                <div class="col-lg-12 col-md-6 col-sm-6 col-12">
                    <h3 class=" pl-1 text-info text-center" style="font-weight:600"> Collection Transfer</h3>
                </div>
            </div>
        </div>

        <hr style="margin: 0.1rem 0;" />
        <div class="form-group row pt-1 pb-3" style="margin-left: 38px;margin-right:20px;opacity:1 !important;">
            <div class="col-lg-6 col-md-6 col-sm-12 col-6">
                <div>
                    <label for="DateFrom" class="form-label">Collection Date</label>
                    <input asp-for="DateFrom" class="form-control" />
                    <button id="btnShowCollection" class="btn btn-primary btn-block">Show Collection</button>
                    @*<button type="submit" id="btnCollectionTransfer" class="btn btn-primary btn-block">Transfer</button>*@
                </div>
            </div>
        </div>
        <div class="form-group row pt-1 pb-3" style="margin-left: 25px;margin-right:5px;opacity:1 !important;">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="table-responsive">
                    <table id="collectionInfo" class="table table-bordered cell-border compact hover stripe dataTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>Collection Date</th>
                                <th>Collection Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {

            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!

            var currentDate = today.getFullYear() + "-" + mm + "-" + dd;
            $('#DateFrom').val(currentDate);



            $('#btnShowCollection').click(function () {
                var collectionDate=$('#DateFrom').val();
                $.ajax({
                    type: "GET",
                    url: "/CollectionTransfer/GetCollectionAmtByDate",
                    data: { 'collectionDate': collectionDate },
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        var collectionTable = $('#collectionInfo tbody');
                        collectionTable.empty();
                        console.log(data);
                        $(data).each(function (index, data) {
                            var linkCollection = "";
                            var trDate="";
                            if (data.trDate == null) {
                                trDate = ""
                            } 
                            else
                            {
                                trDate = data.trDate.substring(0, 10);
                            }

                            if(data.collectionAmt!=0)
                            {
                                linkCollection = '<a href="#" onclick="TransferCollectionByDate(\'' + trDate + '\')">Transfer</a>';
                            }

                            collectionTable.append('<tr><td>' + trDate + '</td><td>' + data.collectionAmt + '</td><td>' + linkCollection + '</td></tr>');
                        });
                    },
                    error: function (xhr, ajaxOptions, thrownError) {
                        // handle error
                    }
                });
            });
        });
        function TransferCollectionByDate(trdate) {
            $.ajax({
                url: '/CollectionTransfer/TransferCollectionByDate',
                data: { 'collectionDate': trdate },
                type: 'POST',
                datatype: JSON,
                success: function (data) {
                    alert(data.message);
                    //location.reload(true);
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }
            });
            return false;
        }

    </script>
}
