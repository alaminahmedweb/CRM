@{
    ViewData["Title"] = "Show Due Advance List";
}


<div class="row mb-2">
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 bg-white">
        <div class="form-group">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12" style="display: flex;justify-content: space-between;margin-left: 18px;">
                <div class="col-lg-5 col-md-6 col-sm-6 col-6">
                    <h3 class=" pl-1 text-info" style="font-weight:600"> Due Advance List</h3>
                </div>
                <div class="col-lg-1 col-md-1 col-sm-1 col-1">
                </div>
            </div>
        </div>
        <hr />
        <div class="form-group row pt-1 pb-3" style="margin-left: 25px;margin-right:5px;opacity:1 !important;">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="table-responsive">
                    <table id="advanceInfo" class="table table-bordered cell-border compact hover stripe dataTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>Advance Date</th>
                                <th>Name Of Reciepent</th>
                                <th>Designation</th>
                                <th>Purpose</th>
                                <th>Due Advance Amt</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            $.ajax({
                type: "GET",
                url: "/AdvanceLedger/GetAllUnAdjustedAdvanceAmt",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    var advanceTable = $('#advanceInfo tbody');
                    advanceTable.empty();

                    var advanceGivenDate = "";
                    var totalAdvanceAmt=0;

                    $(data).each(function (index, data) {
                        if (data.advanceGivenDate == null) {
                            advanceGivenDate = ""
                        } else {
                            advanceGivenDate = data.advanceGivenDate.substring(0, 10);
                        }
                        totalAdvanceAmt+=data.advanceAmt;
                        var linkAdvance = "";

                        linkAdvance = '<a href="/AdvanceLedger/AdjustAdvanceAmt?trNo='+ data.trNo +'">Adjust</a>';

                        advanceTable.append('<tr><td>' + advanceGivenDate + '</td><td>' + data.nameOfReceipent + '</td><td>' +
                            data.designation + '</td><td>' + data.purpose + '</td><td>' + data.advanceAmt + '</td><td>' + linkAdvance + '</td></tr>');
                    });

                    advanceTable.append('<tr><td></td><td></td><td></td><td>Grand Total</td><td>' + totalAdvanceAmt + '</td><td></td></tr>');
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    // handle error
                }
            });

        });

    </script>
}
