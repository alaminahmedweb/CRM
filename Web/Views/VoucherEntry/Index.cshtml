@using ApplicationCore.Entities
@model Web.ViewModels.VoucherEntryMasterVM
@inject UserManager<ApplicationUser> userManager;

@{
    ViewData["Title"] = "Voucher Entry";
    var userid = "";
    if (User.Identity.IsAuthenticated)
    {
        userid = userManager.GetUserId(User);
    }
}
<div class="container-fluid" style="margin-top:-26px;">
    <h6 style="font-family:Verdana;font-weight:700;margin-left:-10px;margin-top:-10px !important;text-decoration-line:underline;" class="text-end">Voucher Entry</h6>
    <hr />
    <form asp-action="Index" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger" id="validationSummary"></div>
        <input type="hidden" asp-for="ModifiedBy" value="@userid" />

        <div class="form-group row mt-3">
            <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-floating">
                    <select asp-for="VoucherType" class="form-control selectbox" id="VoucherType">
                        <option value="PV">PV</option>
                        <option value="RV">RV</option>
                        <option value="BRV">BRV</option>
                        <option value="BPV">BPV</option>
                        <option value="Journal">Journal</option>
                    </select>
                    <label for="VoucherType">Voucher Type</label>
                </div>
                <span asp-validation-for="VoucherType" class="text-danger"></span>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-12">
            </div>

            <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-floating">
                    <input class="form-control" asp-for="VoucherNo" placeholder="Ref No" />
                    <label for="VoucherNo">Ref No.</label>
                </div>
                <span asp-validation-for="VoucherNo" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <table class="entry-form">
                    <tr>
                        <td class="col-sm-6">
                            <select class="form-control selectNoAdd js-example-basic-single" id="acCode" required>
                                <option value="-1">Select Item</option>
                                @if (ViewBag.ChartOfAccountList != null)
                                {
                                    @foreach (var item in @ViewBag.ChartOfAccountList)
                                    {
                                        <option value="@item.Code">@item.Description</option>
                                    }
                                }
                            </select>
                        </td>

                        <td class=col-sm-3>
                            <input class="form-control" id="narration" placeholder="Narration" type="text">
                        </td>

                        <td class="col-sm-1">
                            <input class="form-control" id="debit" placeholder="debit" type="text">
                        </td>
                        <td class="col-sm-1">
                            <input class="form-control" id="credit" placeholder="credit" type="text">
                        </td>
                        <td class="col-sm-1">
                            <button type="button" class="btn btn-sm btn-info" id="btnAdd">Add</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="form-group row mt-2">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="table-scrollable" style="overflow: auto">
                    <table class="table table-hover table-bordered table-striped"
                           style="table-layout: fixed;">
                        <thead class="thead-blue text-center">
                            <tr>
                                <th class="col-sm-5 none"> A/C Code </th>
                                <th class="col-sm-5"> A/C Desc </th>
                                <th class="col-sm-4"> Narration </th>
                                <th class="col-sm-2 debit-input" type="number"> debit </th>
                                <th class="col-sm-2 credit-input" type="number"> Credit </th>
                                <th class="col-sm-2"> Action </th>
                            </tr>
                        </thead>
                        <tbody id="tbltransactDetails" class="text-center"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="form-group row mt-2">
            <div class="col-lg-5 col-md-6 col-sm-6 col-12">
            </div>
            <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                <h5>Grand Total : </h5>
            </div>

            <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-floating">
                    <input class="form-control" id="dbtTotal" disabled name="dbtTotal" placeholder="Total Dr." />
                    <label for="dbtTotal">Total Dr.</label>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-floating">
                    <input class="form-control" id="cdtTotal" disabled name="cdtTotal" placeholder="Total Cr." />
                    <label for="cdtTotal">Total Cr.</label>
                </div>
            </div>
        </div>


        <div class="form-group row mt-2">
            <div class="col-12">
                <div class="form-floating">
                    <input class="form-control" asp-for="Remarks" placeholder="Remarks" />
                    <label for="Remarks">Remarks</label>
                </div>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>
        </div>

        <!-- Add this after your remarks field -->
        <div class="form-group row mt-2">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-floating">
                    <input type="file" class="form-control" asp-for="Attachment"
                           accept=".jpg,.jpeg,.png,.pdf,.doc,.docx">
                    <label for="Attachment">Attachment (Optional)</label>
                </div>
                <small class="text-muted">Supported formats: JPG, PNG, PDF, DOC (Max 5MB)</small>
                <span asp-validation-for="Attachment" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <div class="col-12">
                <div class="form-floating">
                    <input class="form-control" asp-for="AttachmentDescription"
                           placeholder="Attachment Description" />
                    <label for="AttachmentDescription">Attachment Description</label>
                </div>
            </div>
        </div>


        <div class="form-group text-center">
            <input type="button" value="Save" id="SaveTransaction" class="btn btn-primary" />
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="text/javascript">
        $(document).ready(function() {
            $('.js-example-basic-single').select2();

            // Remove these global variables as they're causing issues
            // var debitTotal=0;
            // var creditTotal=0;

            $('#btnAdd').click(function () {
                var acCode = $('#acCode').val();
                var acName = $('#acCode option:selected').text();
                var narrartion = $('#narration').val();
                var debit = parseFloat($('#debit').val()) || 0;
                var credit = parseFloat($('#credit').val()) || 0;

                if (acCode == "-1") {
                    $('#acCode').focus();
                    alert("Please select an account code");
                    return false;
                }
                if (debit === 0 && credit === 0) {
                    $('#debit').focus();
                    alert("Please enter either debit or credit amount");
                    return false;
                }

                var transactionDetailsTable = $('#tbltransactDetails');
                transactionDetailsTable.append('<tr><td class="none">' + acCode + '</td><td>' + acName + '</td><td>' + narrartion + '</td><td>'
                    + debit.toFixed(2) + '</td><td>' + credit.toFixed(2) + '</td><td><a href="#" class="btn btn-outline-danger deleteRow"><span class="fa fa-trash"></span></a></td></tr>');

                // Clear input fields
                $('#debit').val("");
                $('#credit').val("");
                $('#narration').val("");

                // Recalculate totals
                calculateTotals();
            });

            $("#tbltransactDetails").on("click", "a.deleteRow", function (event) {
                event.preventDefault();
                $(this).closest('tr').remove();
                calculateTotals();
                return false;
            });

            function calculateTotals() {
                var debitTotal = 0;
                var creditTotal = 0;

                $("#tbltransactDetails tr").each(function() {
                    // Get the values from the 4th and 5th columns (debit and credit)
                    var debitText = $(this).find('td:eq(3)').text().trim();
                    var creditText = $(this).find('td:eq(4)').text().trim();

                    var debitVal = parseFloat(debitText) || 0;
                    var creditVal = parseFloat(creditText) || 0;

                    debitTotal += debitVal;
                    creditTotal += creditVal;
                });

                $("#dbtTotal").val(debitTotal.toFixed(2));
                $("#cdtTotal").val(creditTotal.toFixed(2));
            }

            $('#SaveTransaction').click(function () {
                var voucherNo = $('#VoucherNo').val();
                var debitTotal = parseFloat($("#dbtTotal").val()) || 0;
                var creditTotal = parseFloat($("#cdtTotal").val()) || 0;

                // Validation
                if(debitTotal != creditTotal) {
                    alert("Debit & Credit Is Not Same..Please Check..");
                    return false;
                }

                var tTransaction = $('#tbltransactDetails');
                var rowCount = 0;

                // Create FormData
                var formData = new FormData();

                // Add attachment file
                var fileInput = $('#Attachment')[0];
                if (fileInput.files.length > 0) {
                    formData.append('VoucherEntryMasterVM.Attachment', fileInput.files[0]);
                }

                // Add other form data
                formData.append('VoucherEntryMasterVM.VoucherNo', $('#VoucherNo').val());
                formData.append('VoucherEntryMasterVM.VoucherType', $('#VoucherType option:selected').val());
                formData.append('VoucherEntryMasterVM.ModifiedBy', $('#ModifiedBy').val());
                formData.append('VoucherEntryMasterVM.Remarks', $('#Remarks').val());
                formData.append('VoucherEntryMasterVM.AttachmentDescription', $('#AttachmentDescription').val());

                // Add voucher details as separate form fields
                var index = 0;
                tTransaction.find('tr').each(function () {
                    var $ctd = $(this).find('td');
                    if ($ctd.length > 0) {
                        var tcAcCode = $ctd.eq(0).text().trim();
                        var tcAcDesc = $ctd.eq(1).text().trim();
                        var tcNarration = $ctd.eq(2).text().trim();
                        var tcDebit = parseFloat($ctd.eq(3).text().trim()) || 0;
                        var tcCredit = parseFloat($ctd.eq(4).text().trim()) || 0;

                        formData.append(`VoucherEntryDetailsVM[${index}].AcCode`, tcAcCode);
                        formData.append(`VoucherEntryDetailsVM[${index}].AcDesc`, tcAcDesc);
                        formData.append(`VoucherEntryDetailsVM[${index}].Narration`, tcNarration);
                        formData.append(`VoucherEntryDetailsVM[${index}].Debit`, tcDebit);
                        formData.append(`VoucherEntryDetailsVM[${index}].Credit`, tcCredit);

                        index++;
                        rowCount++;
                    }
                });

                console.log("Total rows: " + rowCount);

                // Debug: Log all form data entries
                for (var pair of formData.entries()) {
                    console.log(pair[0] + ', ' + pair[1]);
                }

                if (rowCount == 0) {
                    alert("Add Transaction Details Please..");
                    return false;
                }

                $.ajax({
                    type: "POST",
                    url: "/VoucherEntry/Save",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        if (data.redirecturl) {
                            window.location.href = data.redirecturl;
                        }
                    },
                    error: function (response) {
                        if (response.status == 400) {
                            try {
                                var errors = response.responseJSON;
                                if (errors) {
                                    for (var fieldName in errors) {
                                        var errorMessage = errors[fieldName].join('<br>');
                                        if (fieldName.includes('.')) {
                                            fieldName = fieldName.substr(fieldName.indexOf(".") + 1, 100);
                                        }
                                        $('span[data-valmsg-for="' + fieldName + '"]').html(errorMessage);
                                    }
                                } else {
                                    alert('Validation error occurred: ' + response.responseText);
                                }
                            } catch (e) {
                                alert('Error processing response: ' + response.responseText);
                            }
                        } else {
                            alert('Server error: ' + response.statusText);
                        }
                    }
                });
            });

            $('#Attachment').change(function() {
                var file = this.files[0];
                if (file) {
                    // Show file info
                    var fileSize = (file.size / 1024).toFixed(2) + ' KB';
                    $('#attachmentInfo').remove();
                    $(this).after('<div id="attachmentInfo" class="mt-1"><small>Selected: ' +
                                 file.name + ' (' + fileSize + ')</small></div>');
                }
            });
        });
    </script>
}
